{
  "$schema": "https://motiongit.com/schema/motion/0.1.json",
  "format": "motiongit-template",
  "specVersion": "0.1.0-draft.1",
  "template": {
    "id": "product-update-story",
    "version": "0.4.0-rc.5",
    "name": "目标与证据 · 17类语义动效"
  },
  "runtime": {
    "profile": "native-python-node/1",
    "entry": "src/adapter.py",
    "dependencyLock": "motion.lock.json"
  },
  "parameters": {
    "schema": "params.schema.json",
    "defaultPreset": "presets/product-demo.json"
  },
  "assets": {
    "manifest": "asset-manifest.json"
  },
  "output": {
    "width": 1280,
    "height": 720,
    "fps": {
      "num": 24,
      "den": 1
    },
    "durationPolicy": "fit-voiceover"
  },
  "license": {
    "file": "licenses/TEMPLATE-LICENSE.txt"
  },
  "permissions": {
    "network": false,
    "read": [
      "package",
      "instance-inputs"
    ],
    "write": [
      "instance-output"
    ]
  },
  "ai": {
    "entry": "guide.json",
    "guide": "guide.json",
    "authoring": {
      "tool": "codex",
      "client": "codex"
    }
  },
  "integrity": "integrity.json"
}